{
  "window.title": "Validation demo",
  "workbench.colorCustomizations": {
    "diffEditor.insertedLineBackground": "#28a74522",
    "diffEditor.removedLineBackground": "#cb243122",
    "diffEditor.insertedTextBackground": "#28a74566",
    "diffEditor.removedTextBackground": "#cb243166",
    "diffEditor.insertedTextBorder": "#28a745",
    "diffEditor.removedTextBorder": "#cb2431"
  },
  "files.exclude": { ".vscode": true },
  "files.readonlyInclude": { "**/*": true },
  "workbench.startupEditor": "none",
  "workbench.tips.enabled": false,
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "workbench.panel.defaultLocation": "right",
  "editor.fontSize": 26,
  "editor.minimap.enabled": false,
  "editor.wordWrap": "on",
  "editor.wrappingIndent": "indent",
  "editor.lineNumbers": "off",
  "editor.folding": false,
  "editor.glyphMargin": false,
  "editor.stickyScroll.enabled": false,
  "editor.inlineSuggest.enabled": false,
  "github.copilot.enable": { "*": false },
  "powershell.startAutomatically": false,
  "powershell.integratedConsole.showOnStartup": false,
  "breadcrumbs.enabled": false,
  "diffEditor.renderSideBySide": false,
  "diffEditor.ignoreTrimWhitespace": true,
  "diffEditor.hideUnchangedRegions.enabled": true,
  "diffEditor.hideUnchangedRegions.contextLineCount": 1,
  "terminal.integrated.fontSize": 24,
  "terminal.integrated.tabs.enabled": false,
  "terminal.integrated.scrollback": 5000,
  "terminal.integrated.enablePersistentSessions": false,
  "terminal.integrated.defaultProfile.windows": "Validation demo",
  "terminal.integrated.profiles.windows": {
    "Validation demo": {
      "path": "pwsh.exe",
      "args": ["-NoLogo", "-NoExit", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "..\\Start-ValidationDemo.ps1"],
      "overrideName": true
    }
  }
}